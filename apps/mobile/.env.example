# 复制为本目录 .env 后按需修改（.env 已 gitignore，勿提交）
#   copy .env.example .env
#
# 留空或不建 .env：Android 模拟器默认 http://10.0.2.2:3000/v1（见 src/env.ts）
# 真机联调：填电脑局域网 IP（ipconfig 查看 IPv4），API / MinIO 须同机可达

# 例：http://192.168.1.10:3000/v1（必须带 /v1）
API_BASE_URL=

# 例：http://192.168.1.10:9000（餐照预签名；模拟器可留空，默认 10.0.2.2:9000）
STORAGE_PUBLIC_ENDPOINT=
